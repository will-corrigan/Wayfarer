<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.analyzers" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Wayfarer.Core/Wayfarer.Core.csproj" />
    <ProjectReference Include="../Wayfarer.Api/Wayfarer.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For HuntingDatasetShapeTests and UnlockCatalogueShapeTests, which load the real shipped
         files rather than a fixture, so the fixture tests can't silently drift from the packaged
         data. -->
    <Content Include="../data/hunting-targets.json" Link="hunting-targets.json" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../data/unlocks-by-level.json" Link="unlocks-by-level.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
