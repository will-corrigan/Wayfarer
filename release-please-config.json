{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "changelog-sections": [
    { "type": "feat", "section": "New" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Faster" },
    { "type": "revert", "section": "Reverted" },
    { "type": "data", "section": "Unlock data" },
    { "type": "refactor", "section": "Under the hood", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "chore", "section": "Housekeeping", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "ci", "section": "Build", "hidden": true }
  ],
  "extra-files": [
    {
      "type": "xml",
      "path": "Wayfarer/Wayfarer.csproj",
      "xpath": "/Project/PropertyGroup/Version"
    }
  ],
  "packages": {
    ".": {}
  }
}
