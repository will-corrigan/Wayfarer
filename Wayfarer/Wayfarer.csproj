<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- Dalamud.NET.Sdk pins its own transitive package versions (DalamudPackager,
         DotNet.ReproducibleBuilds); Central Package Management would otherwise
         require a matching PackageVersion entry for those. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <Version>1.1.0</Version>
    <Author>Will Corrigan</Author>
    <Name>Wayfarer</Name>
    <Punchline>A quest arrow that knows the way: teleports, doors and aethernet included — plus an unlock checklist.</Punchline>
    <Description>Guides you to your quest objective with an on-screen arrow that understands teleports, building entrances and city aethernet routing. Tracks every quest-unlockable feature, mount and dungeon you can pick up right now, and routes you to the quest givers.</Description>
    <RepoUrl>https://github.com/will-corrigan/Wayfarer</RepoUrl>
    <Tags>quest;navigation;unlocks;qol</Tags>
    <IconUrl>https://raw.githubusercontent.com/will-corrigan/Wayfarer/main/images/icon.png</IconUrl>
    <CanUnloadAsync>true</CanUnloadAsync>
  </PropertyGroup>
  <Import Project="../local.props" Condition="Exists('../local.props')"/>
  <ItemGroup>
    <!-- The native UI toolkit, as the package its author publishes. See THIRD_PARTY_NOTICES.md.
         The version is written here rather than in Directory.Packages.props because the Dalamud SDK
         brings its own versioned packages, which central version management forbids. -->
    <PackageReference Include="KamiToolKit" Version="2.2.45"/>
  </ItemGroup>
  <!-- The routing data the generator wrote (tools/Wayfarer.RoutingGen), shipped beside the DLL. -->
  <ItemGroup>
    <Content Include="../data/routing-graph.json" Link="routing-graph.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
  <!-- CPM is disabled above, so the analyzer references from Directory.Build.props
       need explicit versions here (kept in sync with Directory.Packages.props). -->
  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.2"/>
    <PackageReference Update="StyleCop.Analyzers" Version="1.2.0-beta.556"/>
    <PackageReference Update="Meziantou.Analyzer" Version="3.0.177"/>
  </ItemGroup>

  <!-- Re-installs the Husky.Net git hooks on restore, since .husky/_ is gitignored
       and must be regenerated locally after a fresh clone. -->
  <Target Name="husky" BeforeTargets="Restore;CollectPackageReferences" Condition="'$(HUSKY)' != '0'">
    <Exec Command="dotnet tool restore" StandardOutputImportance="Low" StandardErrorImportance="Low" WorkingDirectory=".."/>
    <Exec Command="dotnet husky install" StandardOutputImportance="Low" StandardErrorImportance="Low" WorkingDirectory=".."/>
  </Target>
</Project>
